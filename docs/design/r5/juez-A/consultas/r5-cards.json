  "witness_decls": [
   {
    "id": "mathlib:ModuleCat.exists_isRegular_tfae",
    "labels": {
     "und": "ModuleCat.exists_isRegular_tfae"
    },
    "descriptions": {
     "en": "**The Rees theorem** For any `n : ℕ`, Noetherian ring `R`, `I : Ideal R`, and finitely generated and nontrivial `R`-module `M` satisfying `IM < M`, the following are equivalent: * for any `N : ModuleCat R` finitely generated and nontrivial with support contained in the zero locus of `I`, `∀ i < n, Ext N M i = 0` * `∀ i < n, Ext (R ⧸ I) M i = 0` * there exists an `N : ModuleCat R` finitely generated and nontrivial with support equal to the zero locus of `I`, `∀ i < n, Ext N M i = 0` * there exists an `M`-regular sequence of length `n` with every element in `I`"
    },
    "type": "statement",
    "derived": null
   },
   {
    "id": "mathlib:Nontrivial",
    "labels": {
     "und": "Nontrivial"
    },
    "descriptions": {
     "en": "Predicate typeclass for expressing that a type is not reduced to a single element. In rings, this is equivalent to `0 ≠ 1`. In vector spaces, this is equivalent to positive dimension."
    },
    "type": "definition",
    "derived": null
   }
  ],
