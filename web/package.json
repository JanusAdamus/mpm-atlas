{
  "name": "atlas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atlas web client: multiscale WebGL2 map, explanation panel, search, paths, text view",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"bench/*.test.mjs\"",
    "bench:fps": "node bench/fps.mjs"
  },
  "dependencies": {
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "puppeteer-core": "25.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
