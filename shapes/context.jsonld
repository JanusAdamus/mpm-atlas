{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/mpm-atlas/vocab#",
    "atlas": "https://w3id.org/mpm-atlas/vocab#",
    "aid": "https://w3id.org/mpm-atlas/id/",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "schema": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "atlasId": "atlas:atlasId",
    "label": {"@id": "skos:prefLabel", "@container": "@language"},
    "altLabel": {"@id": "skos:altLabel", "@container": "@language"},
    "description": {"@id": "schema:description", "@container": "@language"},
    "statementText": {"@id": "atlas:statementText", "@container": "@language"},
    "explanation": {"@id": "atlas:explanation", "@container": "@language"},
    "formula": "atlas:formula",
    "externalId": {"@id": "atlas:externalId", "@container": "@set"},
    "mergedFrom": {"@id": "atlas:mergedFrom", "@type": "@id", "@container": "@set"},
    "relation": {"@id": "atlas:relation", "@type": "@vocab"},
    "evidenceState": {"@id": "atlas:evidenceState", "@type": "@vocab"},
    "participant": {"@id": "atlas:participant", "@container": "@set"},
    "role": {"@id": "atlas:role", "@type": "@vocab"},
    "entity": {"@id": "atlas:entity", "@type": "@id"},
    "assumption": {"@id": "atlas:assumption", "@container": "@set"},
    "validityDomain": "atlas:validityDomain",
    "alternativeGroup": "atlas:alternativeGroup",
    "supersedes": {"@id": "atlas:supersedes", "@type": "@id"},
    "supersededBy": {"@id": "atlas:supersededBy", "@type": "@id"},
    "formalArtifact": "atlas:formalArtifact",
    "library": "atlas:library",
    "version": "atlas:version",
    "declaration": "atlas:declaration",
    "axiom": {"@id": "atlas:axiom", "@container": "@set"},
    "confidence": "atlas:confidence",
    "value": {"@id": "atlas:value", "@type": "xsd:double"},
    "estimates": "atlas:estimates",
    "calibration": "atlas:calibration",
    "historicalDate": "atlas:historicalDate",
    "disagreement": {"@id": "atlas:disagreement", "@container": "@set"},
    "provenance": {"@id": "atlas:provenance", "@container": "@set"},
    "source": {"@id": "prov:hadPrimarySource", "@type": "@id"},
    "locator": "atlas:locator",
    "extractor": "atlas:extractor",
    "extractorVersion": "atlas:extractorVersion",
    "license": "dct:license",
    "retrievedAt": {"@id": "atlas:retrievedAt", "@type": "xsd:dateTime"},
    "quote": "atlas:quote",
    "title": "dct:title",
    "uri": {"@id": "schema:url", "@type": "@id"},
    "sourceKind": "atlas:sourceKind",
    "date": {"@id": "atlas:date", "@container": "@set"},
    "dateKind": {"@id": "atlas:dateKind", "@type": "@vocab"},
    "edtf": {"@id": "atlas:edtf", "@type": "http://id.loc.gov/datatypes/edtf/EDTF"},
    "calendar": "atlas:calendar",
    "raw": "atlas:raw",
    "noteSection": {"@id": "atlas:noteSection", "@type": "@vocab"},
    "noteOrdinal": {"@id": "atlas:noteOrdinal", "@type": "xsd:integer"}
  }
}
